# Steven Picknwear — root access rules
Options -Indexes

# Block sensitive file types anywhere they appear
<FilesMatch "\.(sql|md|log|bak|ini|sh|lock|py|json|example\.php)$">
  Require all denied
</FilesMatch>

# Block all .txt (credentials/notes)…
<FilesMatch "\.txt$">
  Require all denied
</FilesMatch>
# …except robots.txt
<Files "robots.txt">
  Require all granted
</Files>

# Upload limits for this site only (several phone photos at once in the admin)
<IfModule mod_php.c>
  php_value upload_max_filesize 12M
  php_value post_max_size 64M
  php_value max_file_uploads 30
</IfModule>
